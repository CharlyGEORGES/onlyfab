{
  "name": "alain-georges-memorial",
  "version": "1.0.0",
  "private": true,
  "description": "Site d'hommage : photos, souvenirs partagés et modérés, frise de vie, bougies.",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "DATA_DIR=./data ADMIN_PASSWORD=changez-moi SESSION_SECRET=dev-secret node --no-warnings=ExperimentalWarning server.js",
    "fly:deploy": "fly deploy",
    "fly:logs": "fly logs",
    "cf:dev": "wrangler dev --port 8788",
    "cf:setup": "node scripts/setup.mjs",
    "cf:db:init": "wrangler d1 execute alain-georges --local --file=schema.sql",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
